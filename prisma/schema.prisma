// TOUR DNA — Prisma schema
// 데이터 원천(raw snapshot) ↔ 정규화 모델을 분리하고, 프로젝트/분석/전략/실행안을 계약대로 저장한다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── 공통 코드 ──────────────────────────────────────────────

enum RegionLevel {
  SIDO
  SIGUNGU
}

enum UserRole {
  TRAVEL_AGENCY // 여행사/DMC
  LOCAL_GOV // 지자체/관광재단
  FESTIVAL_PLANNER // 축제 기획자(2026-07-30 역할별 결과 차별화 보완)
}

enum Nationality {
  DOMESTIC
  FOREIGN
}

enum TripDuration {
  DAY_TRIP // 당일
  ONE_NIGHT_TWO_DAYS // 1박 2일
  TWO_NIGHTS_THREE_DAYS // 2박 3일
}

enum BudgetLevel {
  LOW // 저가
  MID // 중간
  PREMIUM // 프리미엄
}

enum TransportMode {
  WALK // 도보
  PUBLIC_TRANSPORT // 대중교통
  PRIVATE_VEHICLE // 전용차량
  MIXED // 혼합
}

enum GroupType {
  FIT // 개별/FIT
  SMALL_10_20 // 10~20명
  MEDIUM_21_40 // 21~40명
}

enum ProjectStatus {
  DRAFT // 조건 입력만 완료
  ANALYZED // DNA/전략 분석 완료
  PLANNED // 실행안까지 저장 완료
}

enum DataMode {
  LIVE
  HYBRID
  SNAPSHOT
}

enum AxisStatus {
  LIVE // 이번 동기화의 공공데이터로 계산됨
  SNAPSHOT // 이전 성공 스냅샷으로 대체됨
  MISSING // 데이터 부족
}

/// 개별 지표/근거 값의 데이터 출처 상태(Phase 1-A, 2026-07-23).
/// 기존 레코드는 이 값을 판정할 근거가 없으므로 컬럼을 nullable로 두고 NULL(미분류)로 남긴다 —
/// 어떤 기존 데이터에도 이 5개 값 중 하나를 추측해 배정하지 않는다(Phase 1-B/1-C에서 실제 동기화
/// 경로에 DataSnapshot 연결이 붙은 뒤에야 신뢰성 있게 채울 수 있다).
enum DataProvenance {
  LIVE_API // 실제 API에서 이번 동기화로 받은 값
  CACHED_API // 과거 실제 API 성공 응답을 재사용한 값
  CURATED // 사람이 검수해 만든 POI/관계 데이터
  ESTIMATED // 추정·가공 데모 값
  MISSING // 사용할 수 있는 값 없음
}

enum SnapshotStatus {
  SUCCESS
  EMPTY // API 성공 응답이지만 0건
  ERROR
}

enum SyncTrigger {
  CRON
  ADMIN
  CLI
}

enum SyncOverallStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum PoiCategory {
  ATTRACTION // 관광지
  FOOD // 음식
  LODGING // 숙박
  EXPERIENCE // 체험
  FESTIVAL // 축제/이벤트
  SHOPPING // 쇼핑
}

enum PoiSourceType {
  API
  FIXTURE
}

// ── 행정구역 / 데이터 원천 ──────────────────────────────────

model Region {
  id              String      @id @default(cuid())
  code            String      @unique // 내부 안정 식별자(통계청 행정표준코드 기준, 확인되는 대로 갱신)
  name            String // 한글 명칭 (예: "대전광역시", "제천시")
  level           RegionLevel
  apiAreaCode     String? // 통계청 행정표준코드 시도 2자리(AreaTarDemDsService/AreaTarDivService용). 2026-07-21 실키로 확인됨.
  apiSigunguCode  String? // 통계청 행정표준코드 시군구 5자리(같은 API들의 signguCd 파라미터용). 2026-07-21 실키로 확인됨.
  tourApiAreaCode String? // KorService2 구식 TourAPI areaCode(1~39, 시도 단위). 2026-07-27 신 체계(lDongRegnCd)로 전환 — 신규 요청에는 더 이상 쓰지 않음, 구형 데이터 참고용으로만 보존.
  tourApiLdongRegnCd    String? // KorService2 신 법정동 시도 코드(ldongCode2로 조회). 2026-07-27 도입 — 실키 접근 불가로 아직 값 미확인(전 지역 null).
  tourApiLdongSignguCd  String? // KorService2 신 법정동 시군구 코드. 2026-07-27 도입 — 값이 채워지면 addr1 키워드 필터 없이도 시군구 단위로 정확히 좁힐 수 있다(아직 값 미확인).
  parentId        String?
  parent          Region?     @relation("RegionHierarchy", fields: [parentId], references: [id])
  children        Region[]    @relation("RegionHierarchy")

  snapshots         DataSnapshot[]
  normalizedMetrics NormalizedMetric[]
  pois              Poi[]
  projects          Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
}

model DataSource {
  id          String  @id @default(cuid())
  code        String  @unique // TAR_SVC_DEM | TAR_SJRN_DS | TAR_EXP_DS | TOU_DIV_IX | TOUR_INFO | POI_RELATION
  name        String // 한글명 (예: "지역별 관광 수요 강도")
  baseUrl     String
  description String?

  snapshots DataSnapshot[]
  metrics   NormalizedMetric[]
  pois      Poi[]
  relations PoiRelation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 공공데이터 API 원본 응답(raw)을 그대로 보관하는 스냅샷. 정규화 이전 레이어.
model DataSnapshot {
  id           String         @id @default(cuid())
  dataSourceId String
  dataSource   DataSource     @relation(fields: [dataSourceId], references: [id])
  regionId     String
  region       Region         @relation(fields: [regionId], references: [id])
  baseYm       String
  status       SnapshotStatus
  resultCode   String? // 공공데이터포털 루트 resultCode
  resultMsg    String?
  itemCount    Int            @default(0)
  rawPayload   Json // 원본 items 배열/객체 그대로
  fetchedAt    DateTime       @default(now())

  @@unique([dataSourceId, regionId, baseYm])
  @@index([regionId, baseYm])
}

/// 원본 스냅샷을 정규화 규칙에 따라 변환한 지표. DNA 계산과 근거 패널이 참조하는 단일 출처.
model NormalizedMetric {
  id              String          @id @default(cuid())
  regionId        String
  region          Region          @relation(fields: [regionId], references: [id])
  baseYm          String
  metricCode      String // tarSvcDemIxVal | tarSjrnDsIxVal | tarExpDsIxVal | touDivIxVal 등
  rawValue        Float
  normalizedValue Float? // 동일 행정단위·기준월·지표 코호트 내 정규화 값 (0~100)
  unit            String
  adminLevel      RegionLevel
  sourceId        String
  source          DataSource      @relation(fields: [sourceId], references: [id])
  collectedAt     DateTime        @default(now())
  provenance      DataProvenance? // Phase 1-A: nullable, 기존 레코드는 NULL(미분류) — Phase 1-B/1-C에서 채운다

  @@unique([regionId, baseYm, metricCode])
  @@index([metricCode, baseYm, adminLevel])
}

model Poi {
  id             String        @id @default(cuid())
  externalId     String? // API 제공 고유 ID (fixture는 null 가능)
  regionId       String
  region         Region        @relation(fields: [regionId], references: [id])
  name           String
  category       PoiCategory
  address        String
  lat            Float
  lng            Float
  operatingHours String?
  closedDays     String?
  sourceType     PoiSourceType
  sourceId       String?
  source         DataSource?   @relation(fields: [sourceId], references: [id])
  rawPayload     Json?

  centerOf  PoiRelation[] @relation("CenterPoi")
  relatedOf PoiRelation[] @relation("RelatedPoi")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([regionId, name])
  @@index([regionId, category])
}

model PoiRelation {
  id           String     @id @default(cuid())
  centerPoiId  String
  centerPoi    Poi        @relation("CenterPoi", fields: [centerPoiId], references: [id])
  relatedPoiId String
  relatedPoi   Poi        @relation("RelatedPoi", fields: [relatedPoiId], references: [id])
  relationType String // 예: "연관관광지"
  distanceM    Float?
  sourceId     String
  source       DataSource @relation(fields: [sourceId], references: [id])

  @@unique([centerPoiId, relatedPoiId])
}

model SyncLog {
  id            String            @id @default(cuid())
  baseYm        String
  triggeredBy   SyncTrigger
  overallStatus SyncOverallStatus
  results       Json // [{ sourceCode, status, itemCount, errorMessage? }]
  startedAt     DateTime
  endedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([baseYm])
}

// ── 프로젝트 / 분석 / 전략 / 실행안 ──────────────────────────

model Project {
  id                       String        @id @default(cuid())
  name                     String
  role                     UserRole
  regionId                 String // 시군구 Region
  region                   Region        @relation(fields: [regionId], references: [id])
  sidoCode                 String
  sigunguCode              String
  travelYear               Int
  travelMonth              Int
  status                   ProjectStatus @default(DRAFT)
  selectedStrategyResultId String?
  /// 프로젝트 비밀번호 접근 보호(2026-07-30). scrypt 해시를 "<saltHex>:<hashHex>" 형식 문자열로
  /// 저장한다. null이면 공개 프로젝트(기존 프로젝트는 모두 null로 유지 — 하위 호환). 계정 기반
  /// 소유권이 아니라 "비밀번호를 아는 사람은 누구나 접근 가능"한 수준의 보호다.
  passwordHash             String?

  input          ProjectInput?
  analysisResult AnalysisResult?
  selectedPlan   SelectedPlan?
  accessAttempt  ProjectAccessAttempt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([regionId])
}

/// 프로젝트 비밀번호 확인 실패 횟수를 DB에 기록해 무차별 대입을 방어한다(2026-07-30). Vercel의
/// 서버리스 인스턴스는 상태를 공유하지 않으므로 메모리 카운터로는 실효성이 없어, 요청마다 공유 DB에
/// 기록하는 방식만 사용한다. 프로젝트당 최대 1행(@@unique)만 유지한다.
model ProjectAccessAttempt {
  id          String    @id @default(cuid())
  projectId   String    @unique
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  failedCount Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model ProjectInput {
  id              String        @id @default(cuid())
  projectId       String        @unique
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nationality     Nationality
  ageGroups       Json          @default("[]") // 코드값 배열 (예: ["AGE_20S","AGE_30S"])
  companionType   String // 코드값 (예: COMPANION_FRIENDS)
  primaryGoal     String // 코드값 (예: GOAL_STAY_SPEND)
  secondaryGoal   String?
  duration        TripDuration
  budgetLevel     BudgetLevel
  transport       TransportMode
  groupType       GroupType
  preferredThemes Json          @default("[]")
  excludedThemes  Json          @default("[]")
  memo            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// DNA 5축 분석 결과. 프로젝트당 1건(재분석 시 upsert).
model AnalysisResult {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  demandScore     Float?
  demandStatus    AxisStatus
  stayScore       Float?
  stayStatus      AxisStatus
  spendScore      Float?
  spendStatus     AxisStatus
  diversityScore  Float?
  diversityStatus AxisStatus
  networkScore    Float?
  networkStatus   AxisStatus

  overallDataMode DataMode
  liveAxisCount   Int // 0~5

  strengths     Json // string[] (길이 2)
  opportunities Json // string[] (길이 2)
  cautions      Json // string[] (길이 1)

  // 분석 시점의 지역 전체 POI 카테고리별 개수 스냅샷(Partial<Record<PoiCategoryCode, number>>).
  // 관광사업 기회 3안의 SUPPLY_GAP/TARGET_THEME_GAP 판정 근거를 "분석 당시" 값으로 고정하기 위해
  // 2026-08-02에 추가했다 — POI 동기화로 최신 공급량이 바뀌어도 이미 저장된 분석 결과는 이 스냅샷을
  // 그대로 사용해 임의로 바뀌지 않는다. 이 컬럼 추가 이전에 만들어진 레거시 행은 null이며, 화면에서는
  // 그 경우에만 현재 DB를 조회하는 기존 방식으로 대체한다.
  poiCategorySummary Json?

  // 분석 시점에 계산된 유사지역 비교 결과 전체 스냅샷(RegionComparisonAnalysis, regionSimilarity.ts).
  // 2026-08-10 도입 — 유사지역 비교가 조회 시점마다 전국 SIGUNGU를 다시 계산해, 데이터 sync로
  // NormalizedMetric이 갱신되거나 min-max 코호트가 커지면 같은 분석 결과 화면인데도 상단 DNA
  // 카드(분석 당시 저장값)와 유사지역 비교(재계산값)의 숫자가 달라지는 문제가 있었다. poiCategorySummary와
  // 동일한 원칙으로, 분석 시점에 딱 한 번 계산해 그대로 저장하고 이후에는 사용자가 명시적으로
  // 재분석하기 전까지 이 스냅샷만 사용한다 — 유사지역 후보·순서·점수까지 전부 고정된다. 이 컬럼
  // 도입 이전에 생성된 레거시 행은 null이며, 화면에서는 그 경우에만 예외적으로 현재 DB를 조회하는
  // 기존 방식(재계산)으로 대체한다.
  regionComparisonSnapshot Json?

  analysisKey  String // hash(sortedInput + dataVersion + modelVersion)
  dataVersion  String // 사용된 NormalizedMetric/DataSnapshot 조합의 버전 식별자
  modelVersion String // 예: tour-dna-v1.0.0

  strategyResults StrategyResult[]
  evidences       Evidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([analysisKey])
}

model StrategyResult {
  id               String         @id @default(cuid())
  analysisResultId String
  analysisResult   AnalysisResult @relation(fields: [analysisResultId], references: [id], onDelete: Cascade)

  templateId             String // 예: LOCAL_FOOD_MARKET
  rank                   Int
  name                   String
  concept                String
  totalScore             Float
  scoreBreakdown         Json // { demandFit, supplyFit, seasonFit, targetFit, feasibilityFit, roleFit, roleFitReason? }
  // roleFit/roleFitReason은 Phase 4(역할 적합도)에서 추가됨 — roleFit 도입 이전 레코드에는 두 필드
  // 모두 없을 수 있다(화면에서는 그 경우 "재분석 필요"로 안내한다, 2026-07-29 문서 드리프트 수정).
  reasons                Json // string[] (길이 3)
  targetDescription      String
  poiIds                 Json // string[] (Poi.id)
  consumptionTouchpoints Json // { food: boolean, lodging: boolean, experience: boolean, examples: string[] }
  risks                  Json // string[]
  evidenceIds            Json // string[] (Evidence.id) — 조인 없이 빠른 조회용 캐시
  /// 2026-07-31: 전략 3안 구조적 차별화 필드(역할별 맞춤 분석 완성). 이 필드들이 없던 기존 레코드는
  /// null이며, 화면에서는 그 경우 "재분석 필요"로 안내한다(roleFit과 동일한 하위 호환 패턴).
  coreProblem            String?
  coreResource           String?
  stayStyle              String?
  executionDifficulty    String? // "LOW" | "MEDIUM" | "HIGH"
  expectedEffect         String?

  evidences Evidence[]

  createdAt DateTime @default(now())

  @@unique([analysisResultId, templateId])
  @@index([analysisResultId, rank])
}

/// 축/전략에 연결된 개별 데이터 근거. 원값·정규화값·단위·행정단위·기준월·출처·수집일·반영규칙을 보존한다.
model Evidence {
  id               String          @id @default(cuid())
  analysisResultId String?
  analysisResult   AnalysisResult? @relation(fields: [analysisResultId], references: [id], onDelete: Cascade)
  strategyResultId String?
  strategyResult   StrategyResult? @relation(fields: [strategyResultId], references: [id], onDelete: Cascade)

  axis            String? // Demand | Stay | Spend | Diversity | Network | null(전략 근거)
  metricCode      String
  rawValue        Float
  normalizedValue Float?
  unit            String
  adminLevel      RegionLevel
  regionCode      String
  baseYm          String
  sourceCode      String // DataSource.code
  collectedAt     DateTime
  appliedRule     String // 예: "SIGUNGU 코호트 내 min-max, baseYm=202509"
  provenance      DataProvenance? // Phase 1-A: 분석 당시 provenance 복사본. nullable, 기존 레코드는 NULL(미분류)

  createdAt DateTime @default(now())

  @@index([analysisResultId])
  @@index([strategyResultId])
}

model SelectedPlan {
  id               String  @id @default(cuid())
  projectId        String  @unique
  project          Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  strategyResultId String

  productName        String
  conceptText        String
  background         String // 데이터 기반 기획 배경
  targetSummary      String
  sellingPoints      Json // string[] (길이 3)
  course             Json // { days: [{ dayIndex, items: [{ order, poiId, timeSlot, stayMinutes, travel }] }] }
  operationChecklist Json // string[] (예약/인원/휴무/우천/혼잡/교통)
  risks              Json // [{ risk, mitigation }]
  kpis               Json // [{ name, method }] (3~5개)
  memo               String?
  kpiMemo            String?
  /// Phase 5-A(domain/promoContent.ts)의 PromoContent를 그대로 저장한다. 기존 행은 만든 적이 없으므로
  /// nullable — 마이그레이션에서 기본 콘텐츠를 임의로 채우지 않는다(Phase 5-B, 2026-07-26).
  promoContent       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 카카오모빌리티 자동차 길찾기 실제 응답(거리·시간)의 짧은 TTL 캐시(2026-08-05, Phase 12).
/// 카카오 측 이용약관 확인 결과 응답 결과의 자체 DB 영구 저장은 허용되지 않는다는 안내가 있어(공식
/// 약관 조항 번호까지는 확인하지 못함), 영구 캐시 대신 routeService.ts의 짧은 TTL(기본 24시간) 정책으로만
/// 중복 호출을 줄인다 — TTL이 지나면 이 행은 만료로 간주되어 다시 호출한다(자동 삭제는 하지 않고
/// fetchedAt만으로 판단). fromKey/toKey는 방향성이 있어 A→B와 B→A를 별도 행으로 저장한다(같은 POI쌍이라도
/// 순서를 정렬해 하나로 합치지 않는다).
model RouteCache {
  id           String   @id @default(cuid())
  fromKey      String // 출발 POI id(좌표 대신 POI id를 캐시 키로 쓴다 — CourseItem이 항상 poiId를 갖고 있음)
  toKey        String // 도착 POI id
  transport    String // TransportModeCode 문자열 그대로("PRIVATE_VEHICLE"만 실제로 채워짐)
  provider     String // "KAKAO_MOBILITY"
  routeVersion String // 응답 파싱 규격 버전(향후 파싱 로직이 바뀌면 값을 올려 이전 캐시와 섞이지 않게 한다)
  distanceKm   Float
  minutes      Int
  fetchedAt    DateTime @default(now())

  @@unique([fromKey, toKey, transport, provider, routeVersion])
  @@index([fetchedAt])
}
