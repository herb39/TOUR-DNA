{
  "name": "tour_dna",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:setup": "tsx --env-file=.env.local scripts/setup-e2e-local.mts",
    "test:e2e:local": "tsx --env-file=.env.local scripts/setup-e2e-local.mts --run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env.local prisma/seed.ts",
    "db:seed-poi-curation": "tsx --env-file=.env.local scripts/seed-poi-curation.ts",
    "db:sync-data-sources": "tsx --env-file=.env.local scripts/sync-data-sources.ts",
    "db:generate": "prisma generate",
    "sync:tourism-data": "tsx --env-file=.env.local scripts/sync-tourism-data.ts",
    "check:base-ym": "tsx --env-file=.env.local scripts/check-latest-base-ym.ts",
    "sync:visitor": "tsx --env-file=.env.local scripts/sync-visitor.ts",
    "verify:region": "tsx --env-file=.env.local scripts/verify-region-codes.ts",
    "verify:visitor-api": "tsx --env-file-if-exists=.env.local scripts/verify-visitor-api.ts",
    "audit:region-codes": "tsx --env-file=.env.local scripts/audit-region-codes.ts",
    "audit:tourism-data": "tsx --env-file=.env.local scripts/audit-tourism-data.ts",
    "audit:poi-coordinates": "tsx --env-file=.env.local scripts/audit-poi-coordinates.mts",
    "audit:pet-candidate-coverage": "tsx --env-file=.env.local scripts/audit-pet-candidate-coverage.mts",
    "dataset:activate": "tsx --env-file=.env.local scripts/activate-dataset.ts",
    "dataset:status": "tsx --env-file=.env.local scripts/dataset-status.ts",
    "dataset:discover": "tsx --env-file=.env.local scripts/dataset-discover.ts",
    "dataset:drift": "tsx --env-file=.env.local scripts/dataset-drift.ts",
    "enrich:tour-info-detail": "tsx --env-file=.env.local scripts/enrich-tour-info-detail.ts",
    "enrich:pet-tour-detail": "tsx --env-file=.env.local scripts/enrich-pet-tour-detail.ts",
    "enrich:accessibility": "tsx --env-file=.env.local scripts/enrich-accessibility-detail.ts",
    "enrich:accessibility:representative": "tsx --env-file=.env.local scripts/enrich-accessibility-representative.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
